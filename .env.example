# ─── Database (required) ──────────────────────────────────────────────
# Supabase: Project Settings → Database → Connection string → "Session pooler" (URI)
# e.g. postgresql://postgres.abcdefgh:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/skytrax
DATABASE_POOL_MAX=10

# ─── Auth (required) ──────────────────────────────────────────────────
# Generate with:  openssl rand -base64 48
AUTH_SECRET=replace-with-a-long-random-string-at-least-32-chars
SESSION_HOURS=12

# ─── Storage ──────────────────────────────────────────────────────────
# "s3"    → Supabase Storage / Cloudflare R2 / AWS S3 / Hetzner (recommended for production)
# "local" → files on this server's disk (single VPS only; NOT for Vercel/serverless)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage

# For STORAGE_DRIVER=s3 with Supabase Storage:
#   1. Storage → New bucket "survey-screenshots" (keep it PRIVATE)
#   2. Storage → Settings → S3 Connection → enable, copy endpoint + region, create access keys
# S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
# S3_REGION=ap-south-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET=survey-screenshots

# ─── Upload limits ────────────────────────────────────────────────────
MAX_UPLOAD_MB=10
MAX_FILES_PER_SUBMISSION=10

APP_TIMEZONE=Asia/Kolkata

# ─── Public client view (no login, read-only) ─────────────────────────
# Served at https://<domain>/<CLIENT_VIEW_SLUG>. Anyone with the URL can open it, so in
# production use a long random value:  openssl rand -hex 16   (default: delhiairportclient)
# CLIENT_VIEW_SLUG=delhiairportclient
# Per-IP requests/min for /api/client/* (defaults shown; heavy = ZIP + CSV)
# CLIENT_RATE_API=120
# CLIENT_RATE_FILES=600
# CLIENT_RATE_HEAVY=10

